pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\Gagana\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe'
    }

    stages {

        stage('Check Python') {
            steps {
                bat '"%PYTHON%" --version'
            }
        }

        stage('Run QA Tests') {
            steps {
                bat '"%PYTHON%" -m unittest AirlineReservation_qa.py'
            }
        }

        stage('Run Application') {
            steps {
                bat '"%PYTHON%" AirlineReservation.py'
            }
        }
    }

    post {
        success {
            echo 'Airline Reservation Pipeline PASSED!'
        }

        failure {
            echo 'Airline Reservation Pipeline PASSED!'
        }
    }
}
